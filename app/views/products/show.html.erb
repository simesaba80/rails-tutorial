<% cache @product do %>
    <%= image_tag @product.featured_image if @product.featured_image.attached?%>
    <h1><%= @product.name %></h1>
    <%= @product.description %>
<% end %>

<%= link_to "Back", products_path%>
<%= link_to "Edit", edit_product_path(@product.id) if authenticated? %>
<%= button_to "Delete", product_path(@product.id), method: :delete, data: { turbo_confirm: "Are you sure?" } if authenticated? %>